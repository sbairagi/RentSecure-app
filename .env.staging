NODE_ENV=staging
APP_ENV=staging

# API Configuration
EXPO_PUBLIC_API_URL=https://api-staging.securenest.com/api/v1
EXPO_PUBLIC_API_TIMEOUT=30000
EXPO_PUBLIC_API_RETRY_COUNT=3

# App Configuration
EXPO_PUBLIC_APP_NAME=SecureNest Staging
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_APP_SCHEME=securenest-staging

# Sentry Configuration
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=securenest-mobile-staging

# Feature Flags
EXPO_PUBLIC_ENABLE_ANALYTICS=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true

# Third Party Keys
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
