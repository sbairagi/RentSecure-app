# Expo / React Native Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to version control.

# API
# Development: set to your Mac's LAN IP so Expo Go on iPhone can reach it.
#   Find it with: ipconfig getifaddr en0  (macOS)
# Example: EXPO_PUBLIC_API_URL=http://192.168.1.4:8000/api
# Staging:   EXPO_PUBLIC_API_URL=https://api-staging.securenest.com/api
# Production:EXPO_PUBLIC_API_URL=https://api.securenest.com/api
EXPO_PUBLIC_API_URL=http://localhost:8000/api

# Sentry
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=rentsecure-mobile

# EAS
EAS_PROJECT_ID=

# App
EXPO_PUBLIC_APP_ENV=development
